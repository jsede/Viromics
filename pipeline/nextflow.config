/*
========================================================================================
    Viromics Pipeline Configuration
========================================================================================
*/

params {
    // Pipeline Options
    platform            = 'illumina' // 'illumina' or 'ont'
    reads               = null       // Path pattern to FastQ files (e.g. 'data/*_R{1,2}.fastq.gz')
    sample_sheet        = null       // Optional path to CSV samplesheet input
    reference           = null       // Path to reference genome FASTA
    gff                 = null       // Optional path to GFF3 annotation file
    primer_bed          = null       // Optional path to primer scheme BED file
    amplicons_bed       = null       // Optional path to explicit amplicon coordinates BED file
    metadata            = null       // Optional path to sample metadata CSV file

    // Consensus & Variant Calling Filters
    min_coverage        = null       // Minimum depth for variant calling (auto-default by platform if null)
    min_freq            = null       // Minimum allele frequency to report variants (auto-default by platform if null)
    min_qual            = 20         // Minimum base quality for alignment and variants
    min_variant_qual    = 20         // Minimum variant quality (QUAL) for VCF filtering
    min_consensus_depth = null       // Minimum depth to call consensus base (falls back to min_coverage if null)
    use_iupac           = false      // Output IUPAC ambiguity codes for mixed sites in consensus
    ont_adapter         = 'AACGCTTTCGCGTTTTTCGTGCGCCGCTTCA' // Adapter sequence for ONT adapter trimming (BBDuk)

    // Output Directory
    outdir              = './results'
}

profiles {
    standard {
        process.executor = 'local'
    }
    
    conda {
        conda.enabled          = true
        process.conda          = 'bioconda::fastp bioconda::bwa bioconda::minimap2 bioconda::samtools bioconda::bcftools bioconda::ivar bioconda::bbmap'
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        process.container      = 'biocontainers/biocontainers:v1.2.0_cv1'
    }
}

// Global Process Settings
process {
    withName: 'FASTQ_QC' {
        cpus = 2
        memory = '4 GB'
    }
    withName: 'ALIGN_READS' {
        cpus = 4
        memory = '8 GB'
    }
    withName: 'PRIMER_TRIM' {
        cpus = 2
        memory = '4 GB'
    }
    withName: 'VARIANT_CALL' {
        cpus = 2
        memory = '4 GB'
    }
}

// Enable Nextflow HTML reports
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
