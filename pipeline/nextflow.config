/*
========================================================================================
    Viromics Pipeline Configuration
========================================================================================
*/

manifest {
    name            = 'viromics'
    author          = 'Viromics Contributors'
    description     = 'Viral amplicon whole-genome sequencing & genomic epidemiology pipeline'
    mainScript      = 'pipeline/main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '2.0.0'
}

params {
    help                = false

    // Pipeline Options
    run_id              = null       // Deterministic default resolves to viromics_<sessionId> in main.nf
    platform            = 'illumina' // 'illumina' or 'ont'
    reads               = null       // Path pattern to FastQ files (e.g. 'data/*_R{1,2}.fastq.gz')
    sample_sheet        = null       // Optional path to CSV samplesheet input
    reference           = null       // Path to reference genome FASTA
    gff                 = null       // Optional path to GFF3 annotation file
    primer_bed          = null       // Optional path to primer scheme BED file
    amplicons_bed       = null       // Optional path to explicit amplicon coordinates BED file
    metadata            = null       // Optional path to sample metadata CSV file
    cds_models          = "${projectDir}/../resources/annotation_models/cds_models.json" // Curated CDS translation exception models

    // Read QC (Illumina fastp / ONT fastplong)
    ont_min_mean_qual   = 10         // Minimum mean read Phred quality for ONT (fastplong --mean_qual)
    ont_min_length      = 100        // Minimum ONT read length after trimming (fastplong --length_required)
    ont_max_length      = 0          // Maximum ONT read length (0 = unlimited; fastplong --length_limit)
    ont_trim_adapters   = false      // Enable de novo fastplong adapter auto-detection (disabled via -A by default so conserved amplicon ends are not clipped)
    ont_adapter_fasta   = null       // Optional FASTA of custom ONT adapter sequences (fastplong -a); null = skip unless ont_trim_adapters=true
    ont_adapter         = null       // Optional single ONT adapter sequence literal (backwards-compatible)

    // Alignment & Primer Trimming
    min_map_qual        = 20         // Minimum mapping quality (MAPQ) for alignment filtering, depth, and variant calling
    min_base_qual       = null       // Minimum base quality (BaseQ) for depth & variant calling (auto-default: 20 Illumina, 15 ONT)
    min_qual            = null       // Deprecated alias for min_base_qual (honored if explicitly set)
    primer_tolerance    = null       // samtools ampliconclip --tolerance (auto-default: 5 Illumina, 15 ONT)
    min_clipped_len     = null       // samtools ampliconclip --filter-len (auto-default: 30 Illumina, 50 ONT)

    // Consensus & Variant Calling Filters
    ont_mpileup_config  = 'ont-sup'  // bcftools mpileup -X config for ONT (e.g. 'ont-sup', 'ont', or 'none')
    min_coverage        = null       // Minimum HQ depth for variant calling (auto-default: 10 Illumina, 50 ONT)
    min_freq            = null       // Minimum allele frequency to report variants (auto-default: 0.2 Illumina, 0.5 ONT)
    min_variant_qual    = 20         // Minimum variant quality (VCF QUAL)
    disable_baq         = true       // Pass -B (--no-BAQ) to bcftools mpileup (recommended for viral genomes)
    max_mpileup_depth   = 100000     // Max per-file depth for bcftools mpileup (-d and -L); triggers deterministic strand-balanced downsampling if exceeded
    downsample_seed     = 42         // Fixed seed for deterministic strand-balanced downsampling
    min_consensus_depth = null       // Minimum HQ depth to call consensus base; lower masked as N (defaults to min_coverage)
    min_consensus_freq  = 0.50       // Minimum allele frequency for haploid consensus (and major indels under IUPAC)
    use_iupac           = false      // Output IUPAC ambiguity codes for mixed biallelic SNPs in consensus
    min_iupac_freq      = 0.25       // Lower AF bound (inclusive) for IUPAC biallelic SNP ambiguity calling
    max_iupac_freq      = 0.75       // Upper AF bound (exclusive) for IUPAC biallelic SNP ambiguity calling

    // Sample Quality Classification Tiers (evaluated on callable target when primer/amplicon BED supplied)
    qc_pass_depth       = 100        // Minimum mean depth for PASS
    qc_pass_breadth     = 95.0       // Minimum callable breadth (%) at min_coverage for PASS
    qc_pass_max_n       = 5.0        // Maximum internal N rate (%) for PASS
    qc_warn_depth       = 25         // Minimum mean depth for WARN
    qc_warn_breadth     = 80.0       // Minimum callable breadth (%) at min_coverage for WARN
    qc_warn_max_n       = 10.0       // Maximum internal N rate (%) for WARN

    // Container & Resource Ceilings
    container_image     = 'viromics:2.0.0' // Override with custom registry image or Singularity .sif path
    max_cpus            = 16
    max_memory          = '32.GB'
    max_time            = '24.h'

    // Output Directory
    outdir              = './results'
}

profiles {
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled          = true
        process.conda          = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        process.container      = { params.container_image }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = { params.container_image }
    }
}

// Global Process Settings & Ceilings
process {
    cpus          = { Math.min(1 * task.attempt, params.max_cpus as int) }
    memory        = { (2.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (2.GB * task.attempt) }
    time          = { (1.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (1.h * task.attempt) }
    errorStrategy = { task.exitStatus in [104, 130, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withName: 'INDEX_REFERENCE' {
        cpus   = { Math.min(1 * task.attempt, params.max_cpus as int) }
        memory = { (2.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (2.GB * task.attempt) }
        time   = { (1.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (1.h * task.attempt) }
    }
    withName: 'FASTQ_QC' {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { (4.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (4.GB * task.attempt) }
        time   = { (2.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (2.h * task.attempt) }
    }
    withName: 'ALIGN_READS' {
        cpus   = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { (8.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (8.GB * task.attempt) }
        time   = { (4.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (4.h * task.attempt) }
    }
    withName: 'PRIMER_TRIM' {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { (4.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (4.GB * task.attempt) }
        time   = { (2.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (2.h * task.attempt) }
    }
    withName: 'VARIANT_CALL' {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { (4.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (4.GB * task.attempt) }
        time   = { (4.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (4.h * task.attempt) }
    }
    withName: 'CONSENSUS_GEN' {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { (4.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (4.GB * task.attempt) }
        time   = { (2.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (2.h * task.attempt) }
    }
    withName: 'AGGREGATE_METRICS' {
        cpus   = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { (4.GB * task.attempt).compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0 ? (params.max_memory as nextflow.util.MemoryUnit) : (4.GB * task.attempt) }
        time   = { (2.h * task.attempt).compareTo(params.max_time as nextflow.util.Duration) > 0 ? (params.max_time as nextflow.util.Duration) : (2.h * task.attempt) }
    }
}

// Enable Nextflow HTML reports
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
