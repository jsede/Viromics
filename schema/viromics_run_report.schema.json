{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viromics.org/schema/viromics_run_report.schema.json",
  "title": "Viromics Run Report",
  "description": "Structured per-run output contract generated by Viromics parse_metrics.py and consumed by the Viromics React Dashboard.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "run_config",
    "software_versions",
    "min_coverage_threshold",
    "references",
    "genes",
    "distance_matrices",
    "distance_matrix_order",
    "distance_matrices_by_name",
    "snp_distance_matrices",
    "compared_sites_matrices",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_config": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "platform",
        "min_coverage",
        "min_freq",
        "min_consensus_depth",
        "min_consensus_freq",
        "min_map_qual",
        "min_base_qual",
        "qc_thresholds"
      ],
      "properties": {
        "platform": { "type": "string" },
        "min_coverage": { "type": "integer", "minimum": 0 },
        "min_freq": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "min_consensus_depth": { "type": "integer", "minimum": 0 },
        "min_consensus_freq": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "min_map_qual": { "type": "integer", "minimum": 0 },
        "min_base_qual": { "type": "integer", "minimum": 0 },
        "qc_thresholds": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "pass_depth",
            "pass_breadth",
            "pass_max_n",
            "warn_depth",
            "warn_breadth",
            "warn_max_n"
          ],
          "properties": {
            "pass_depth": { "type": "integer", "minimum": 0 },
            "pass_breadth": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
            "pass_max_n": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
            "warn_depth": { "type": "integer", "minimum": 0 },
            "warn_breadth": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
            "warn_max_n": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
          }
        }
      }
    },
    "software_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "min_coverage_threshold": {
      "type": "integer",
      "minimum": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "length", "sequence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "length": { "type": "integer", "minimum": 0 },
          "sequence": { "type": "string" }
        }
      }
    },
    "genes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["name", "type", "start", "end", "strand"],
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 },
            "strand": { "type": "string" }
          }
        }
      }
    },
    "distance_matrices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": ["number", "null"], "minimum": 0.0 }
        }
      }
    },
    "distance_matrix_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "distance_matrices_by_name": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": { "type": ["number", "null"], "minimum": 0.0 }
        }
      }
    },
    "snp_distance_matrices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "compared_sites_matrices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "sample_id",
          "qc_status",
          "qc_reasons",
          "primary_reference",
          "qc",
          "coverage",
          "variants",
          "consensus",
          "metadata",
          "amplicons"
        ],
        "properties": {
          "sample_id": { "type": "string", "minLength": 1 },
          "qc_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "qc_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "primary_reference": { "type": ["string", "null"] },
          "qc": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "raw_reads",
              "raw_bases",
              "trimmed_reads",
              "trimmed_bases",
              "q30_rate_raw",
              "q30_rate_trimmed",
              "duplication_rate"
            ],
            "properties": {
              "raw_reads": { "type": "integer", "minimum": 0 },
              "raw_bases": { "type": "integer", "minimum": 0 },
              "trimmed_reads": { "type": "integer", "minimum": 0 },
              "trimmed_bases": { "type": "integer", "minimum": 0 },
              "q30_rate_raw": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
              "q30_rate_trimmed": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
              "duplication_rate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
              "mean_read_length_raw": { "type": ["number", "null"], "minimum": 0.0 },
              "mean_read_length_trimmed": { "type": ["number", "null"], "minimum": 0.0 }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "mean_depth",
                "coverage_breadth_10x",
                "coverage_breadth_30x",
                "coverage_breadth_min_cov",
                "mapped_reads",
                "coverage_profile",
                "low_coverage_intervals",
                "callable_target_length",
                "callable_target_intervals",
                "callable_mean_depth",
                "callable_breadth_min_cov",
                "qc_basis",
                "qc_status",
                "qc_reasons"
              ],
              "properties": {
                "mean_depth": { "type": "number", "minimum": 0.0 },
                "coverage_breadth_10x": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "coverage_breadth_30x": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "coverage_breadth_min_cov": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "mapped_reads": { "type": "integer", "minimum": 0 },
                "coverage_profile": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pos", "depth"],
                    "properties": {
                      "pos": { "type": "integer", "minimum": 1 },
                      "depth": { "type": "number", "minimum": 0.0 }
                    }
                  }
                },
                "low_coverage_intervals": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "integer", "minimum": 1 }
                  }
                },
                "callable_target_length": { "type": "integer", "minimum": 0 },
                "callable_target_intervals": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "integer", "minimum": 1 }
                  }
                },
                "callable_mean_depth": { "type": "number", "minimum": 0.0 },
                "callable_breadth_min_cov": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "qc_basis": { "type": "string", "enum": ["primer_bed", "amplicons_bed", "whole_contig"] },
                "qc_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
                "qc_reasons": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "reference",
                "position",
                "ref",
                "alt",
                "quality",
                "depth",
                "frequency",
                "is_consensus",
                "gene",
                "type",
                "aa_change",
                "consequences"
              ],
              "properties": {
                "reference": { "type": "string" },
                "position": { "type": "integer", "minimum": 1 },
                "ref": { "type": "string", "minLength": 1 },
                "alt": { "type": "string", "minLength": 1 },
                "quality": { "type": ["number", "null"], "minimum": 0.0 },
                "depth": { "type": "integer", "minimum": 0 },
                "frequency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "is_consensus": { "type": "boolean" },
                "gene": { "type": "string" },
                "type": { "type": "string" },
                "aa_change": { "type": "string" },
                "status": { "type": ["string", "null"] },
                "consequences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["gene", "protein_id", "product", "aa_change", "effect", "status"],
                    "properties": {
                      "gene": { "type": "string" },
                      "protein_id": { "type": ["string", "null"] },
                      "product": { "type": ["string", "null"] },
                      "aa_change": { "type": "string" },
                      "effect": { "type": "string" },
                      "status": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          },
          "consensus": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "length",
                "gc_content",
                "n_content",
                "internal_n_content",
                "internal_n_count",
                "terminal_n_count",
                "sequence"
              ],
              "properties": {
                "length": { "type": "integer", "minimum": 0 },
                "gc_content": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "n_content": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "internal_n_content": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "internal_n_count": { "type": "integer", "minimum": 0 },
                "terminal_n_count": { "type": "integer", "minimum": 0 },
                "sequence": { "type": "string" }
              }
            }
          },
          "metadata": {
            "type": "object"
          },
          "amplicons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "amplicon_id",
                "reference",
                "start",
                "end",
                "mean_depth",
                "min_depth",
                "median_depth",
                "percent_bases_above_threshold",
                "status"
              ],
              "properties": {
                "amplicon_id": { "type": "string" },
                "reference": { "type": "string" },
                "start": { "type": "integer", "minimum": 1 },
                "end": { "type": "integer", "minimum": 1 },
                "mean_depth": { "type": "number", "minimum": 0.0 },
                "min_depth": { "type": "number", "minimum": 0.0 },
                "median_depth": { "type": "number", "minimum": 0.0 },
                "percent_bases_above_threshold": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "status": { "type": "string", "enum": ["pass", "fail"] }
              }
            }
          }
        }
      }
    }
  }
}
